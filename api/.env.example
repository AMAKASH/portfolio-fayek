# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated browser origins allowed to call the API (UI + admin origin). No trailing slash.
CORS_ORIGINS=http://localhost:4200,http://localhost:4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Dokploy/Traefik = 1)
TRUST_PROXY=1

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/portfolio
MONGO_MAX_POOL=10
# Indexes are auto-built outside production. In production run `npm run db:indexes` (or set this to true).
MONGO_AUTO_INDEX=false

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Optional: set when the API and UI live on different subdomains, e.g. .example.com
COOKIE_DOMAIN=

# ---- Admin bootstrap (created on first boot only if no admin exists) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- S3 / CloudFront ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary STS credentials
AWS_SESSION_TOKEN=
S3_BUCKET=
# Public CDN base URL, no trailing slash, e.g. https://d123abc.cloudfront.net
CLOUDFRONT_URL=
# Key prefix inside the bucket
S3_PREFIX=uploads

# ---- Upload limits (MB) ----
MAX_IMAGE_MB=20
MAX_VIDEO_MB=500

# ---- Caching ----
# TTL for the in-memory cache and Cache-Control max-age of public endpoints. 0 disables.
PUBLIC_CACHE_TTL_SECONDS=60

# ---- Seeding ----
# Public origin of the UI. Local ../../../assets/... paths in seed JSON become ${PUBLIC_SITE_URL}/assets/...
PUBLIC_SITE_URL=http://localhost:4200

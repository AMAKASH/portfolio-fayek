{
  "name": "portfolio-fayek-api",
  "version": "1.0.0",
  "private": true,
  "description": "Projects API for the portfolio-fayek site (Express 5 + TypeScript + MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-projects.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "db:indexes": "tsx --env-file-if-exists=.env scripts/sync-indexes.ts",
    "seed:prod": "node dist/scripts/seed-projects.js",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "db:indexes:prod": "node dist/scripts/sync-indexes.js",
    "migrate:assets": "tsx --env-file-if-exists=.env scripts/migrate-local-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-presigned-post": "^3.1172.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mongoose": "^8.24.10",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}

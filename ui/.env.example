# Runtime settings for the UI's Node server. Copy to `.env` (git-ignored).
# Read by: the SSR server (`npm run serve:ssr:portfolio-fayek`), the dev proxy (`ng serve`),
# and the dev server's SSR pass. In Docker/Dokploy set these as container env vars instead.
# Browser-side settings (API base URL, site title) are build-time: src/environments/*.ts

# Port of the SSR server (production / serve:ssr)
PORT=4000

# Where the API is, as seen from this server:
#  - SSR data fetches go here
#  - the /api proxy (prod server.ts and dev proxy.conf.mjs) forwards here
# Local: http://localhost:5000   Docker network: http://api:5000
API_INTERNAL_URL=http://localhost:5000

# Seconds to cache rendered public HTML in memory (0 disables). Admin edits appear after this.
SSR_CACHE_TTL=60
